            </column>
            <column caption='Prior Month Running Sum' datatype='real' name='[Calculation_3675359527261339660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_3675359527260917770]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Revenue' datatype='real' name='[Calculation_4229091175111970840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[quantity] * [unit_price]' />
