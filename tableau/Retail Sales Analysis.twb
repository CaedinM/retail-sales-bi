      <column caption='Day of Month' datatype='integer' name='[Calculation_3675359527260700679]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DAY([Invoice Date (copy)_4229091175109091350])' />
      </column>
      <column caption='Cutoff Day' datatype='integer' name='[Calculation_3675359527260778504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 3]) = #2011-12-01# THEN&#10;    9&#10;ELSE&#10;    31&#10;END' />
      </column>
      <column caption='Current Month Revenue' datatype='real' name='[Calculation_3675359527260848137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;, [Invoice Date (copy)_4229091175109091350]) = [Parameters].[Parameter 3]&#10;AND DAY([Invoice Date (copy)_4229091175109091350]) &lt;= [Calculation_3675359527260778504]&#10;THEN [Calculation_4229091175111970840]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Prior Month Revenue' datatype='real' name='[Calculation_3675359527260917770]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;, [Invoice Date (copy)_4229091175109091350]) = DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 3])&#10;THEN [Calculation_4229091175111970840]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Current Month Running Sum' datatype='real' name='[Calculation_3675359527261245451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_3675359527260848137]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
